# ==============================================================================
# Dependency & Virtual Environments
# ==============================================================================
node_modules/
**/node_modules/
venv/
**/venv/
.venv/
**/__pycache__/
*.py[cod]
*$py.class

# ==============================================================================
# Production Builds & Packaging
# ==============================================================================
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local

# Capacitor & Mobile Builds
android/app/build/
**/android/app/build/
android/.gradle/
**/android/.gradle/
ios/App/build/
**/ios/App/build/
ios/App/Pods/
**/ios/App/Pods/

# ==============================================================================
# Logs, Runtime & Media Downloads
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
server.log
dev.log
backend/server.log
frontend/dev.log

# Temporary media files (preserve folder with .gitkeep)
backend/downloads/*
!backend/downloads/.gitkeep

# ==============================================================================
# Secrets & Sensitive Data
# ==============================================================================
.env
*.env
backend/.env
backend/cookies.txt
frontend/.env.local
frontend/.env.*.local

# ==============================================================================
# OS & Editor Files
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
